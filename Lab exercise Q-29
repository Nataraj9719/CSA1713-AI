
% Facts
parent(john, mary).
parent(mary, sam).
parent(sam, alex).

% Rules
grandparent(X, Z) :-
    parent(X, Y),
    parent(Y, Z).

great_grandparent(X, Z) :-
    parent(X, Y),
    grandparent(Y, Z).

