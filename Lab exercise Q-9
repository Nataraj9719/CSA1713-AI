
from itertools import permutations

def travelling_salesman(graph, start):
    n = len(graph)
    cities = list(range(n))
    cities.remove(start)

    min_cost = float('inf')
    best_path = []

    for route in permutations(cities):
        path = [start] + list(route) + [start]
        cost = 0

        for i in range(len(path) - 1):
            cost += graph[path[i]][path[i + 1]]

        if cost < min_cost:
            min_cost = cost
            best_path = path

    print("Shortest Path:", " -> ".join(map(str, best_path)))
    print("Minimum Distance:", min_cost)


# Distance matrix
graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

travelling_salesman(graph, 0)
