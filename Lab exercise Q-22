
% Facts
male(john).
male(robert).
male(david).
female(mary).
female(alice).
female(susan).

% Parent relationships
parent(john, robert).
parent(mary, robert).
parent(robert, alice).
parent(susan, alice).
parent(robert, david).
parent(susan, david).

% Rules
father(X, Y) :-
    male(X),
    parent(X, Y).

mother(X, Y) :-
    female(X),
    parent(X, Y).

child(X, Y) :-
    parent(Y, X).

sibling(X, Y) :-
    parent(Z, X),
    parent(Z, Y),
    X \= Y.
