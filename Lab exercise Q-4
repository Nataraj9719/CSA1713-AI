from itertools import permutations

def solve_cryptarithm():
    letters = "SENDMORY"
    digits = range(10)

    # M, S cannot be 0 because they are the first letters
    for perm in permutations(digits, len(letters)):
        mapping = dict(zip(letters, perm))

        if mapping['S'] == 0 or mapping['M'] == 0:
            continue

        SEND = (
            mapping['S'] * 1000 +
            mapping['E'] * 100 +
            mapping['N'] * 10 +
            mapping['D']
        )

        MORE = (
            mapping['M'] * 1000 +
            mapping['O'] * 100 +
            mapping['R'] * 10 +
            mapping['E']
        )

        MONEY = (
            mapping['M'] * 10000 +
            mapping['O'] * 1000 +
            mapping['N'] * 100 +
            mapping['E'] * 10 +
            mapping['Y']
        )

        if SEND + MORE == MONEY:
            print("Solution found:")
            print("SEND =", SEND)
            print("MORE =", MORE)
            print("MONEY =", MONEY)
            print("\nLetter-Digit Mapping:")

            for letter in sorted(mapping):
                print(letter, "=", mapping[letter])

            return

    print("No solution found.")


# Main program
solve_cryptarithm()
