
from collections import deque

def is_valid(m, c):
    # Check whether the number of people is within limits
    if m < 0 or c < 0 or m > 3 or c > 3:
        return False

    # Cannibals must not outnumber missionaries
    # on either bank when missionaries are present
    if m > 0 and c > m:
        return False

    mr = 3 - m
    cr = 3 - c

    if mr > 0 and cr > mr:
        return False

    return True


def solve():
    # State: (missionaries_left, cannibals_left, boat_position)
    # Boat position: 0 = left bank, 1 = right bank
    start = (3, 3, 0)
    goal = (0, 0, 1)

    # Possible boat movements
    moves = [
        (1, 0),  # 1 missionary
        (2, 0),  # 2 missionaries
        (0, 1),  # 1 cannibal
        (0, 2),  # 2 cannibals
        (1, 1)   # 1 missionary and 1 cannibal
    ]

    queue = deque([(start, [start])])
    visited = {start}

    while queue:
        state, path = queue.popleft()
        m, c, boat = state

        if state == goal:
            print("Solution found!\n")

            for step, (m, c, boat) in enumerate(path):
                side = "Left" if boat == 0 else "Right"
                print(
                    f"Step {step}: Left bank: M={m}, C={c} | "
                    f"Right bank: M={3-m}, C={3-c} | "
                    f"Boat: {side}"
                )
            return

        for dm, dc in moves:
            if boat == 0:
                new_state = (m - dm, c - dc, 1)
            else:
                new_state = (m + dm, c + dc, 0)

            if new_state not in visited and is_valid(
                new_state[0], new_state[1]
            ):
                visited.add(new_state)
                queue.append((new_state, path + [new_state]))

    print("No solution found.")


solve()
